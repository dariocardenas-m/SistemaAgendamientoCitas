{
  "realm": "piedrazul",
  "enabled": true,
  "displayName": "Red Médica Piedra Azul",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "ADMINISTRADOR", "description": "Administra la parametrización del sistema" },
      { "name": "AGENDADOR", "description": "Consulta y gestiona agendas médicas" },
      { "name": "MEDICO_TERAPISTA", "description": "Consulta y atiende su propia agenda" },
      { "name": "PACIENTE", "description": "Reserva y administra sus propias citas" }
    ]
  },
  "clients": [
    {
      "clientId": "piedrazul-app",
      "name": "Piedra Azul Web y Postman",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "Piedra Azul API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "piedrazul-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "user.attribute": "emailVerified",
            "jsonType.label": "boolean"
          }
        }
      ]
    }
  ]
}
